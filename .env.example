# ── Server ──
NODE_ENV=development
PORT=3010
LOG_LEVEL=info

# ── Postgres (same DB as uzeed) ──
DATABASE_URL=postgresql://uzeed:uzeed@db:5432/uzeed?schema=public

# ── Redis (BullMQ + state) ──
REDIS_URL=redis://redis:6379

# ── Internal API auth (shared secret with uzeed) ──
# Used to validate incoming REST calls from uzeed.
INTERNAL_API_SECRET=replace-me-with-strong-random-secret

# ── Webhooks back to uzeed ──
# Uzeed exposes /webhooks/whatsapp/* on its API. Baileys signs each payload
# with HMAC-SHA256 using WEBHOOK_SECRET.
UZEED_WEBHOOK_URL=http://api:3001/webhooks/whatsapp
WEBHOOK_SECRET=replace-me-with-strong-random-secret

# ── Anti-ban tuning ──
# Hours during which the service refuses to send messages (circadian rest).
QUIET_HOURS_START=2
QUIET_HOURS_END=8
# Per-message gaussian read delay (ms): mean ± stdev, clamped [min, max]
READ_DELAY_MEAN_MS=1500
READ_DELAY_STDEV_MS=600
READ_DELAY_MIN_MS=400
READ_DELAY_MAX_MS=4500
# Per-message typing dwell: ms per word + jitter
TYPING_MS_PER_WORD=300
TYPING_JITTER_MS=400

# ── Health checks ──
HEALTH_CHECK_INTERVAL_MIN=5
SHADOWBAN_CHECK_INTERVAL_MIN=60
WARMUP_ADVANCE_CRON=0 3 * * *
